{
  "openapi": "3.0.0",
  "info": {"title": "Online Bookstore API", "version": "1.0.0"},
  "paths": {
    "/books": {
      "get": {
        "tags": ["books"],
        "summary": "List books with pagination",
        "parameters": [
          {"name": "page", "in": "query", "schema": {"type": "integer", "minimum": 1, "default": 1}},
          {"name": "limit", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 50, "default": 20}}
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {"type": "array"},
                    "total": {"type": "integer"}
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["books"],
        "summary": "Create a book (admin)",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["title", "author", "price"],
                "properties": {
                  "title": {"type": "string"},
                  "author": {"type": "string"},
                  "price": {"type": "number", "minimum": 0.01}
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {"type": "object", "properties": {"id": {"type": "integer"}}}
              }
            }
          },
          "400": {"description": "Validation error"}
        }
      }
    },
    "/books/{id}": {
      "get": {
        "tags": ["books"],
        "summary": "Book detail",
        "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "integer"}}],
        "responses": {
          "200": {"description": "OK"},
          "404": {"description": "Not found"}
        }
      },
      "delete": {
        "tags": ["books"],
        "summary": "Delete a book (admin)",
        "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "integer"}}],
        "responses": {"204": {"description": "Deleted"}}
      }
    },
    "/cart/items": {
      "post": {
        "tags": ["cart"],
        "summary": "Add cart item",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["bookId", "quantity"],
                "properties": {
                  "bookId": {"type": "integer"},
                  "quantity": {"type": "integer", "minimum": 1}
                }
              }
            }
          }
        },
        "responses": {"201": {"description": "Added"}}
      }
    },
    "/cart/items/{id}": {
      "delete": {
        "tags": ["cart"],
        "summary": "Remove cart item",
        "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "integer"}}],
        "responses": {
          "204": {"description": "Removed"},
          "404": {"description": "Not found"}
        }
      }
    },
    "/orders": {
      "post": {
        "tags": ["orders"],
        "summary": "Place order from cart",
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {"type": "object", "properties": {"orderId": {"type": "integer"}}}
              }
            }
          }
        }
      }
    },
    "/orders/{id}/payment": {
      "post": {
        "tags": ["payment"],
        "summary": "Pay an order",
        "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "integer"}}],
        "responses": {"200": {"description": "Paid"}}
      }
    },
    "/orders/{id}/shipment": {
      "post": {
        "tags": ["logistics"],
        "summary": "Ship a paid order",
        "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "integer"}}],
        "responses": {"201": {"description": "Shipped"}}
      }
    }
  }
}
