# LLM Configuration
# OpenAI (default)
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL accepts a comma-separated list of model names.
# - The first model is the primary (used for normal generation).
# - Subsequent models are fallback candidates (used when the primary call
#   fails after retries) AND cross-validation reviewers when REVIEW_ENABLED=true.
# - Single model is fine; review will reuse it with a logged warning.
# Examples:
#   OPENAI_MODEL=gpt-4o-mini                    # single model
#   OPENAI_MODEL=gpt-4o-mini,gpt-4o             # primary + 1 fallback/reviewer
#   OPENAI_MODEL=gpt-4o-mini,gpt-4o,gpt-4-turbo # primary + 2 fallbacks
OPENAI_MODEL=gpt-4o-mini
# Request timeout in seconds
OPENAI_TIMEOUT=300
# Max output tokens per LLM response (lower = faster but may truncate long outputs)
OPENAI_MAX_OUTPUT_TOKENS=16000
# Max number of LLM batches generated concurrently in the async path.
# Bounds the asyncio semaphore so we never flood the provider with simultaneous
# requests (which would trip 429 rate limits). Default: 5
OPENAI_MAX_CONCURRENCY=5
# Run a zero-token model availability check (GET /v1/models/{model}) before
# generation starts, so a bad API key / base_url / model name fails fast
# instead of hanging for minutes. Disable (false) only if your provider does
# NOT implement the OpenAI /models API. Default: true
OPENAI_VERIFY_MODEL=true
# Stream tokens for real-time progress logs (live char count while generating).
# If the provider rejects streaming, the client falls back to blocking. Default: true
OPENAI_STREAM=true
# Model profile (plan v10): explicit override of the automatic per-model
# profile resolution. Empty = auto-match by model name (deepseek-v4* ->
# deepseek-v4 profile; gpt-5*/o1/o3/o4 -> openai-reasoning; gpt-4o*/gpt-4.1*
# -> openai-classic; qwen3.x* -> qwen3.8; anything else -> generic). Use this
# when a gateway/proxy renames models. Unknown names fail fast at startup.
# Known profiles: deepseek-v4, qwen3.8, openai-reasoning, openai-classic,
# generic-openai-compatible. Default: empty (auto)
OPENAI_MODEL_PROFILE=
# First-round reasoning effort intent (e.g. low / medium / high / disabled).
# This is an INTENT, not a raw parameter: the resolved profile translates it
# into the model's dialect. Empty = model default. Default: empty
OPENAI_REASONING_EFFORT=
# One-shot downgrade effort for budget-exhausted recovery (plan v10 §5).
# Empty = use the profile default (deepseek: disabled, qwen: low,
# openai-reasoning: low; classic/generic have none and skip downgrading).
# Default: empty
OPENAI_CONTINUATION_REASONING_EFFORT=
# Qwen only: thinking_budget cap applied when the downgrade effort is "low".
# Default: 4096
OPENAI_CONTINUATION_THINKING_BUDGET=4096
# Hard wall-clock limit (seconds) for a single blocking (non-streaming) LLM
# call. An EXPLICIT value is honoured verbatim and must be >= OPENAI_TIMEOUT
# (startup fails otherwise); unset (0) means max(OPENAI_TIMEOUT * 2, 600).
# Exceeding it raises LLMCallTimeoutError into a bounded retry + model
# fallback path instead of waiting forever on a wedged provider.
# Default: 0 (unset)
OPENAI_BLOCKING_HARD_TIMEOUT=0

# Hard wall-clock limit (seconds) for a single STREAMING LLM call. A stream that
# keeps delivering chunks (reasoning-heavy models stream thinking tokens
# continuously) never trips the transport read timeout, so without this cap a
# single call was bounded only by the provider's own budget — a multi-minute
# silent wait that looks identical to a hang.
# Same contract as OPENAI_BLOCKING_HARD_TIMEOUT: an EXPLICIT value must be
# >= OPENAI_TIMEOUT; unset (0) means max(OPENAI_TIMEOUT * 2, 600).
# Default: 0 (unset)
OPENAI_STREAM_HARD_TIMEOUT=0

# Escape hatch for models that are NOT in the profile registry. The registry
# translates OPENAI_REASONING_EFFORT into each model family's dialect, so an
# unregistered model silently receives NO thinking control at all (startup
# logs "thinking/effort parameters will be dropped"). Supply the exact JSON
# fragment your provider documents; it is merged into every request's
# extra_body (operator keys win over the profile fragment).
# Examples: {"enable_thinking": false}   {"thinking_budget": 4096}
# Default: empty (disabled)
# OPENAI_EXTRA_BODY_JSON='{"enable_thinking": false}'

# Task-package pipeline (plan-c): directory scanned for task packages — each
# subdirectory with a manifest.json becomes a CLI command. Underscore-
# prefixed packages (e.g. _example) are hidden but runnable by name.
# Default: ./tasks
TASKS_DIR=./tasks

# Azure OpenAI (optional, set AZURE_OPENAI_ENABLED=true to use)
AZURE_OPENAI_ENABLED=false
AZURE_OPENAI_API_KEY=your-azure-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

# Performance Test Configuration
PERF_BASE_URL=https://api.example.com
PERF_VIRTUAL_USERS=100
PERF_DURATION_SECONDS=300
PERF_RAMP_UP_SECONDS=60
PERF_THINK_TIME_MS=500

# Output Configuration
OUTPUT_DIR=./output

# Logging Configuration
# LOG_LEVEL: root log level for the "testagent" logger. Drives application
# logging (case-insensitive). One of: DEBUG, INFO, WARNING, ERROR, CRITICAL.
# An invalid value fails fast at startup. The CLI flag -v/--verbose overrides
# this to DEBUG for a single run. Default: INFO
# LOG_LEVEL=INFO
# LOG_LEVEL=DEBUG
# Task-package pipeline: mask individual task packages from CLI registration
# (comma-separated names) — rollback switch during the legacy migration.
# No settings field; read directly by the CLI registration layer.
# Default: empty
TASKS_DISABLE=
# Task-package pipeline: how many pre_review_snapshot files to keep under
# OUTPUT_DIR (oldest pruned first). No settings field; read from env.
# Default: 50
CHECKPOINT_KEEP_LAST=50

# Pipeline Configuration
# REVIEW_ENABLED: run a second-pass LLM review after generating test cases
#   (fresh conversation, no context; merges/fixes/completes the case list).
#   When multiple models are configured, review alternates between the
#   primary and a secondary model for cross-validation. Default: false
REVIEW_ENABLED=false
# REVIEW_MAX_ROUNDS: number of cross-validation rounds when REVIEW_ENABLED=true.
#   Round 1 uses the secondary model, round 2 the primary, round 3 secondary...
#   Each round refines the previous round's output. Default: 2
REVIEW_MAX_ROUNDS=2
# OUTPUT_LANGUAGE: "chinese" or "english" - language of generated cases and reports. Default: chinese
OUTPUT_LANGUAGE=chinese

# --- quality line (fix-plan T1/T7/T9) ---
AUDIT_DUMP_ENABLED=true
CONFLICT_POLICY=strict
CASES_BUDGET=60

# --- cross-module links pipeline (plan-links-v15 §3.2) ---
LINKS_ENABLED=true
LINKS_PROSE_ENABLED=true
LINKS_R6_MIN_SCORE=1.0
LINKS_MAX_NEIGHBORS=4
LINKS_NEIGHBOR_CHARS=1200
LINKS_CLUSTER_SIZE=6
LINKS_MAX_PLANNED_PATHS=8
LINKS_MAX_HOPS=3
LINKS_L3B_MAX_CALLS=3
LINKS_SEEDING=priority
LINKS_L0_MAX_CHARS=8000

# --- modular capabilities (plan-modular-capabilities-v4 §3.1) ---
SPLIT_MODE=auto
SINGLE_DOC_WARN_TOKENS=8000
REVIEW_CHUNK_SIZE=20
REVIEW_MAX_CHUNK_FAILURE_RATIO=0.5
REVIEW_MAX_PROMPT_CHARS=48000
GUI_REFERENCE_MAX_CASES=30
GUI_REFERENCE_MAX_CHARS=16000
